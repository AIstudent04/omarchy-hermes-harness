#!/usr/bin/env bash
set -u

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
safe_io="$script_dir/hermes-safe-io"
vps_url="${1:-}"
usage_file="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage/hermes.json"
base='{}'
usage_candidate="$($safe_io read 262144 "$usage_file" 2>/dev/null || true)"
if [[ -n "$usage_candidate" ]]; then
  validated_base="$(jq -ce 'select(type == "object")' <<<"$usage_candidate" 2>/dev/null || true)"
  if [[ -n "$validated_base" && ${#validated_base} -le 262144 ]]; then
    base="$validated_base"
  fi
fi

if [[ -n "$vps_url" && "$vps_url" =~ ^https?:// ]]; then
  # Remote mode: read a Hermes gateway's public /api/status instead of checking
  # this machine for a local install. Bounded the same way local subprocess
  # calls are (hermes-safe-io run), read-only, no auth token or credentials
  # sent or stored. See docs/architecture.md and docs/security.md.
  remote_json="$($safe_io run 4 65536 -- curl -fsS --max-time 3 "${vps_url%/}/api/status" 2>/dev/null || true)"
  remote_valid="$(jq -ce 'select(type == "object")' <<<"$remote_json" 2>/dev/null || true)"

  if [[ -n "$remote_valid" ]]; then
    jq -cn --argjson r "$remote_valid" '
      ($r.gateway_state // "") as $gs
      | {
          installed: true,
          version: ($r.version // ""),
          gatewayState: (if $gs == "running" then "active"
                         elif $gs == "" then "unknown"
                         else "stopped" end),
          activeModel: "",
          currentSessionId: "",
          currentSessionTitle: (($r.active_sessions // 0) | tostring) + " active session(s) on VPS",
          hermesNodeAvailable: true,
          nodes: (
            [($r.profiles // [])[] as $p | {($p): {online: (($r.gateway_running // false) == true)}}]
            | add // {}
          ),
          nodesOnline: (if ($r.gateway_running // false) == true then (($r.profiles // []) | length) else 0 end),
          nodesTotal: (($r.profiles // []) | length)
        }'
    exit 0
  fi

  # Remote fetch failed or returned invalid JSON: fall through and report an
  # honest "unreachable" status rather than silently checking this machine
  # for a local install the user explicitly opted out of.
  jq -cn '{
    installed: false,
    version: "",
    gatewayState: "unknown",
    activeModel: "",
    currentSessionId: "",
    currentSessionTitle: "VPS unreachable",
    hermesNodeAvailable: false,
    nodes: {},
    nodesOnline: 0,
    nodesTotal: 0
  }'
  exit 0
fi

hermes_bin="$(command -v hermes 2>/dev/null || true)"
installed=false
version=""
gateway_state="unknown"
active_model=""

if [[ -n "$hermes_bin" ]]; then
  installed=true
  version_output="$($safe_io run 5 4096 -- "$hermes_bin" --version 2>/dev/null || true)"
  IFS=$'\n' read -r version _ <<<"$version_output"
  version="${version:0:512}"

  if systemctl --user is-active --quiet hermes-gateway.service 2>/dev/null; then
    gateway_state="active"
  elif systemctl --user is-enabled --quiet hermes-gateway.service 2>/dev/null; then
    gateway_state="stopped"
  else
    gateway_state="not-installed"
  fi
fi

config_file="${HERMES_HOME:-$HOME/.hermes}/config.yaml"
config_content="$($safe_io read 65536 "$config_file" 2>/dev/null || true)"
if [[ -n "$config_content" ]]; then
  active_model="$(awk -F': *' '$1 == "model" { value=$2; gsub(/"/, "", value); print value; exit }' <<<"$config_content")"
fi
if [[ -z "$active_model" ]]; then
  active_model="$(jq -r '.activeModel // ""' <<<"$base" 2>/dev/null)"
fi
active_model="${active_model:0:256}"

node_bin="$(command -v hermes-node 2>/dev/null || true)"
node_available=false
nodes='{}'
nodes_online=0
nodes_total=0
if [[ -n "$node_bin" ]]; then
  node_available=true
  node_output="$($safe_io run 18 65536 -- "$node_bin" status 2>/dev/null || true)"
  while IFS= read -r line; do
    [[ "$line" =~ ^([A-Za-z0-9._-]{1,64}):[[:space:]]+(online|offline)$ ]] || continue
    name="${BASH_REMATCH[1]}"
    state="${BASH_REMATCH[2]}"
    online=false
    [[ "$state" == online ]] && online=true
    nodes="$(jq -c --arg name "$name" --argjson online "$online" '. + {($name): {online: $online}}' <<<"$nodes")"
    ((nodes_total += 1))
    [[ "$online" == true ]] && ((nodes_online += 1))
  done <<<"$node_output"
fi

if [[ "$nodes_total" -eq 0 ]]; then
  nodes="$(jq -c '.nodes // {}' <<<"$base" 2>/dev/null || printf '{}')"
  nodes_total="$(jq -r '.nodesTotal // (.nodes // {} | length) // 0' <<<"$base" 2>/dev/null || printf '0')"
  nodes_online="$(jq -r '.nodesOnline // ([.nodes // {} | to_entries[] | select(.value.online == true)] | length) // 0' <<<"$base" 2>/dev/null || printf '0')"
fi

jq -cn \
  --argjson base "$base" \
  --argjson installed "$installed" \
  --arg version "$version" \
  --arg gateway "$gateway_state" \
  --arg model "$active_model" \
  --argjson nodeAvailable "$node_available" \
  --argjson nodes "$nodes" \
  --argjson nodesOnline "$nodes_online" \
  --argjson nodesTotal "$nodes_total" \
  '$base + {
    installed: $installed,
    version: $version,
    gatewayState: $gateway,
    activeModel: $model,
    hermesNodeAvailable: $nodeAvailable,
    nodes: $nodes,
    nodesOnline: $nodesOnline,
    nodesTotal: $nodesTotal
  }
  | .currentSessionId = ((.currentSessionId // "") | tostring | .[0:256])
  | .currentSessionTitle = ((.currentSessionTitle // "") | tostring | .[0:512])'
